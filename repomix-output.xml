// Componente isolado com o conteúdo de Login
function LoginContent({
  showLogin,
  setShowLogin,
  email,
  setEmail,
  password,
  setPassword,
  loading,
  handleLogin,
}: LoginContentProps) {
  const [mostrarSenha, setMostrarSenha] = useState(false);

  return (
    <>
      {/* LOGO SUPERIOR (ÍCONE) */}
