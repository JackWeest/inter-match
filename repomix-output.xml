            <div className="absolute bottom-6 left-6 right-6 flex flex-col gap-1">
              <h2 className="text-3xl font-black italic text-white leading-none truncate drop-shadow-lg uppercase">
                {profile.nome || 'Anônimo'}, {profile.idade || '?'}
